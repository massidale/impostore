{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "node",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "rootDir": "..", "outDir": "lib"
  },
  "include": ["index.ts", "../server/**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
